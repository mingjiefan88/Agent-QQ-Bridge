  "narrative": {
    "northStar": "本地运行台",
    "overview": "The existing visual world is a conventional Chinese Windows operation interface. Its restrained shell makes configuration and current execution legible without adding an expressive marketing identity. The user selected contextual settings beside a large, persistent terminal, with NapCat's native interface as a functional reference.\n\nThe terminal is literal working content: real events, public progress, replies and receipts. White surfaces and a muted sidebar organize controls; one action blue identifies primary actions and selection. This record merges the existing decisions with the implemented CSS rather than changing their direction.",
    "keyCharacteristics": [
      "Contextual settings beside a persistent terminal.",
      "Quiet surfaces with one action accent.",
      "Explicit operating states instead of decorative activity.",
      "Native desktop typography for controls, monospace for log data."
    ],
    "rules": [
      {
        "name": "The State Before Decoration Rule",
        "body": "Use the existing action and status treatments to communicate actual state; do not substitute invented activity for an empty or offline condition.",
        "section": "colors"
      },
      {
        "name": "The Data Face Rule",
        "body": "Keep monospace in logs and measurements; ordinary instructions and controls retain the UI face.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Preserve tonal and border separation for daily controls; reserve elevation for the nested native interface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve contextual settings beside the large monitor on wide screens, and stack them without horizontal page overflow on narrow screens.",
      "**Do** use explicit text for waiting, offline, paused, success and failure states.",
      "**Do** keep focus, caret, selection and terminal scrollbars consistent with the shipped palette.",
      "**Do** retain native UI typography for controls and monospace for actual log data."
    ],
    "donts": [
      "**Don't** add a decorative label above the page heading; the redundant eyebrow was removed in the final correction.",
      "**Don't** put ordinary configuration into modal dialogs; the native nested management interface is the documented exception.",
      "**Don't** add ambient panel shadows or glowing accents to flat application surfaces.",
      "**Don't** present placeholder counts, fake online states or simulated activity as live operating evidence."
    ]
  }
}

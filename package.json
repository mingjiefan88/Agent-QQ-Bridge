{
  "name": "codex-qq-bridge",
  "version": "1.0.0",
  "description": "Codex 专用 QQ 机器人插件与集成控制台",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm --prefix .agents/plugins/codex-qq-bridge start",
